# Copy this file to .env and fill in your real values.
# .env is loaded by config.py via python-dotenv. Never commit your real .env.

FLASK_SECRET_KEY=change_this_to_a_long_random_string
FLASK_ENV=development
FLASK_DEBUG=1

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stock_portfolio_db
DB_PORT=3306

# Starting virtual cash given to every new user (paper trading)
DEFAULT_VIRTUAL_BALANCE=1000000.00
